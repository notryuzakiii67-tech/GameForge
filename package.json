{
  "name": "gameforge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-presigned-post": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@next/env": "16.4.0",
    "bcryptjs": "^3.0.2",
    "fflate": "^0.8.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "0.160.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "postcss": "^8.5.30"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.160.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
