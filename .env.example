# Local development defaults. Copy this file to .env.local.
# Local SQLite and file storage are development conveniences only; production must use PostgreSQL and S3-compatible object storage.
DATABASE_URL=file:.gameforge-local/gameforge.sqlite
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production game-content hostname. Leave empty for local development.
# In Vercel, point a dedicated HTTPS hostname (for example https://games.example.com)
# to this same project/deployment. It must be distinct from NEXT_PUBLIC_SITE_URL.
GAME_CONTENT_ORIGIN=

# S3-compatible object storage (required for production publishing).
# Set S3_ENDPOINT for providers with a custom endpoint (for example an S3-compatible service).
# Keep the bucket private; builds are streamed through the isolated GameForge content route.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional local disk path. This is ignored by Git and is not durable on Vercel.
LOCAL_STORAGE_DIR=.gameforge-local/storage

# Resource / cost controls. Vercel request-body limits still apply to ZIP uploads.
MAX_UPLOAD_BYTES=4194304
MAX_EXPANDED_BYTES=41943040
MAX_ARCHIVE_FILES=300
MAX_GAME_VERSIONS=8
MAX_AI_VERSIONS=20
AI_DAILY_LIMIT=5
AI_HOURLY_LIMIT=5
AI_TIMEOUT_MS=45000
DATABASE_POOL_SIZE=1
