# Local development defaults. Copy this file to .env.local.
# Local SQLite and file storage are development conveniences only; production must use PostgreSQL and S3-compatible object storage.
DATABASE_URL=file:.gameforge-local/gameforge.sqlite
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production game-content hostname. Leave empty for local development.
# In Vercel, point a dedicated HTTPS hostname (for example https://games.example.com)
# to this same project/deployment. It must be distinct from NEXT_PUBLIC_SITE_URL.
GAME_CONTENT_ORIGIN=

# S3-compatible object storage (required for production publishing).
# Set S3_ENDPOINT for providers with a custom endpoint (for example an S3-compatible service).
# Keep the bucket private; builds are streamed through the isolated GameForge content route.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional local disk path. This is ignored by Git and is not durable on Vercel.
LOCAL_STORAGE_DIR=.gameforge-local/storage

# Resource / cost controls. Vercel request-body limits still apply to ZIP uploads.
MAX_UPLOAD_BYTES=4194304
MAX_EXPANDED_BYTES=41943040
MAX_ARCHIVE_FILES=300
MAX_GAME_VERSIONS=8
MAX_AI_VERSIONS=20
# Individual private assets: 20 MiB default (application cap 50 MiB).
MAX_ASSET_BYTES=20971520
ASSET_USER_QUOTA_BYTES=104857600
ASSET_MAX_PER_USER=100
AI_DAILY_LIMIT=5
AI_HOURLY_LIMIT=5
AI_TIMEOUT_MS=45000

# Optional AI providers. Keep credentials server-side; the Studio never accepts API keys from clients.
# Gemini is the Studio default. On provider quota/rate limits the fallback order is Gemini → Mistral → Groq.
# Configure only providers you intend to use; fallback prompts may be sent to another external provider,
# and each account has separate availability, terms, quotas, and possible charges.
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
# Optional provider model IDs for quota fallback. If unset/unavailable, GameForge selects the first discovered generative model.
AI_MISTRAL_FALLBACK_MODEL=
AI_GROQ_FALLBACK_MODEL=

# Optional account recovery. Until configured, forgot-password and email verification return a clear service-unavailable response.
# Generate a 32-byte server-only HMAC secret with: openssl rand -hex 32
ACCOUNT_RECOVERY_SECRET=
# Resend API key and a sender address verified with Resend. Never use NEXT_PUBLIC_ variables.
RESEND_API_KEY=
GAMEFORGE_EMAIL_FROM=

DATABASE_POOL_SIZE=1
