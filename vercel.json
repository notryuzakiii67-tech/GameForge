{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/ai/generate/route.ts": { "maxDuration": 60 },
    "src/app/api/games/*/upload/route.ts": { "maxDuration": 30 },
    "src/app/api/ai/projects/*/publish/route.ts": { "maxDuration": 30 }
  }
}
